DATABASE_URL=postgresql+psycopg2://agentproof:agentproof@localhost:5432/agentproof

# Simulator credentials — two distinct roles, enforced on every simulator request.
# The agent may only call action (write) endpoints; AgentProof may only call
# read (verification) endpoints. Neither credential grants the other's access.
AGENT_WRITE_CREDENTIAL=agent-write-demo-credential
VERIFIER_READ_CREDENTIAL=verifier-read-demo-credential

# Base URL the agent and the evidence adapter use to reach the simulator's
# HTTP endpoints (real network boundary, not an in-process shortcut).
SIMULATOR_BASE_URL=http://127.0.0.1:8000

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
